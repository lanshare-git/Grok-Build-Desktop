{
  "name": "grok-build-desktop",
  "version": "0.29.0",
  "description": "Grok Build 桌面 Agent 客户端 — 基于 ACP 协议复用终端版 Grok Build 的登录态、模型与工具",
  "main": "./out/main/index.js",
  "author": "FJH",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "pack:linux": "npm run build && electron-builder --linux dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux deb",
    "sync-app": "node scripts/sync-app.mjs",
    "deploy": "npm run pack && npm run sync-app",
    "install:linux": "node scripts/install-linux.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "version:show": "node scripts/version.mjs",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "rehype-highlight": "^7.0.1",
    "highlight.js": "^11.10.0",
    "zustand": "^5.0.1",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.fjh.grokbuild.desktop",
    "productName": "GrokBuildDesktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Grok Build Desktop"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icons",
      "executableName": "grok-build-desktop",
      "maintainer": "FJH <257783038+lanshare-git@users.noreply.github.com>",
      "desktop": {
        "Name": "Grok Build Desktop",
        "Comment": "Grok Build 桌面 Agent 客户端",
        "Categories": "Development;Utility;",
        "StartupWMClass": "grok-build-desktop"
      }
    },
    "deb": {
      "packageName": "grok-build-desktop",
      "priority": "optional",
      "afterInstall": "scripts/deb-after-install.sh"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Grok Build Desktop",
      "uninstallDisplayName": "Grok Build Desktop"
    },
    "extraResources": [
      "build"
    ]
  }
}
